# Copy to backend/.env or set these variables in your shell before starting Spring Boot.
DB_URL=jdbc:mysql://localhost:3306/movie_booking?createDatabaseIfNotExist=true
DB_USERNAME=movie_user
DB_PASSWORD=


# Location services
ORS_API_KEY=
LOCATION_ALLOWED_RADIUS_KM=25

# Cloudflare Turnstile CAPTCHA
TURNSTILE_SECRET_KEY=


# Email delivery (SMTP; required outside the dev profile)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
NOTIFICATION_EMAIL_FROM=

ADMIN_EMAIL=
